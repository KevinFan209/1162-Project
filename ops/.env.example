# PyPoly ops bot 環境變數範本
# 使用方式：複製本檔為 .env（放在 ops/ 目錄下），填入實際值。
# ops/.env 已被 gitignore，不會進版控。

# ── Discord ──────────────────────────────────────────────
# 於 https://discord.com/developers/applications 建立 Application → Bot → Reset Token 取得
DISCORD_TOKEN=

# 你的 Discord 伺服器 ID（開啟開發者模式後在伺服器上按右鍵→複製伺服器 ID）
# 有填：slash 指令立即在該伺服器生效（開發時建議）
# 留空：註冊為全域指令，最久要等 1 小時才會出現
GUILD_ID=

# ── PyPoly ───────────────────────────────────────────────
# 留空則自動使用 ops/ 的上一層目錄下的 PyPoly/
PYPOLY_DIR=
SERVER_PORT=8000

# ── 多分支工作區 ─────────────────────────────────────────
# 存放各分支 worktree 的上層資料夾。頂層與 GitHub 上的 repo 同名，
# 底下每個分支一個資料夾：
#     1162-Project\
#       ├── main\      ← bot.py 從這裡跑
#       ├── Fan-map\
#       └── …
# /start <分支> 會把伺服器的工作目錄切到對應的資料夾，分支不存在的話
# 會自動用 git worktree 建好。
#
# 留空則推算為「bot 所在倉庫的上一層」，照上面的結構擺放時會自動正確。
# 絕對路徑因人而異，所以放在這裡而不是寫死在 config.py。
PROJECT_ROOT=

# /start 沒指定分支、且尚未啟動過時要用哪個分支。留空預設 main。
DEFAULT_BRANCH=

# ── ngrok ────────────────────────────────────────────────
# 固定的公開網域。留空則使用 config.py 裡的預設值。
# 這不是機密——它就是組員要開的公開網址，寫進版控也無妨。
# authtoken 不放這裡：用 `ngrok config add-authtoken <token>` 設定，
# 存在 ngrok 自己的設定檔，不經過本專案。
NGROK_DOMAIN=

# ── /ask 問答功能用的 LLM 後端（留空則 /ask 回報未設定，其他指令不受影響）──
# 🏆 這裡現在接的是 Open WebUI（不是裸的 llama.cpp 伺服器），
# 需要帶 API 金鑰才能用程式呼叫：登入後到帳號設定 → 帳號 → API 金鑰
# 產生一個，這是機密，千萬不要提交進版控、也不要貼到 Discord 或任何對話裡。
LLAMA_BASE_URL=http://192.168.0.109:3000
LLAMA_API_KEY=

# 強烈建議手動指定要用哪個模型 id（在 Open WebUI 建立對話時的模型下拉
# 選單可以看到）。留空會嘗試自動偵測，但那段邏輯是為裸 llama.cpp 寫的，
# 接到 Open WebUI 後很可能偵測不到或偵測錯。
LLAMA_MODEL=

# ── GitHub（/issue 待辦清單才會用到，不用就留空）──────────
# 個人存取權杖（classic PAT），需要 repo 範圍——要能建立/關閉/編輯/
# 刪除 issue。於 https://github.com/settings/tokens 建立，這是機密，
# 千萬不要提交進版控。
GITHUB_TOKEN=

# owner/repo（例如 KevinFan209/1162-Project）。留空則自動從
# CONTROL_WORKTREE 的 git remote origin 推算，通常不用填。
GITHUB_REPO=

# ── 頻道限制（選填，留空＝不限制、哪個頻道都能用）──────────
# 讓特定指令只能在特定頻道使用。開啟「進階→開發者模式」後對頻道
# 按右鍵「複製頻道 ID」取得。
# /start /restart /status /branches /stop /url /ask 這七個指令
CHANNEL_OPS_ID=
# /issue 底下的六個子指令（list/add/check/uncheck/edit/delete）
CHANNEL_ISSUE_ID=
